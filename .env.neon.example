# Copy to .env.neon (git-ignored) to run migrations, seeding and the role check against Neon from this machine:
#   pnpm db:migrate    --env-file=.env.neon
#   pnpm db:seed       --env-file=.env.neon
#   pnpm db:check-role --env-file=.env.neon
# Only this file is loaded (never .env.local), and a non-local database is touched only when named this way.
# This file holds the migrator's credentials: keep it on a trusted machine, never on Vercel.

# Fictional demonstration data lives here, so the deployed demo is a "preview" environment (seeding allowed,
# secure cookies, simulator scenarios off by default, admin account not seeded).
APP_ENV=preview
LOG_LEVEL=info

# gothere_migrator, DIRECT (unpooled) host: ep-xxxx.<region>.aws.neon.tech — no "-pooler". Used only by db:migrate.
MIGRATION_DATABASE_URL=
# After migrating, grant the runtime role access to every table (re-applied on every migration).
DATABASE_APP_ROLE=gothere_app

# gothere_app, DIRECT host. Used by db:seed and db:check-role (seeding runs as the restricted role).
DATABASE_URL=
# gothere_app, POOLED host: ep-xxxx-pooler.<region>.aws.neon.tech — exactly what Vercel will use. Checked by db:check-role.
RUNTIME_DATABASE_URL=

# Must equal the values you put on Vercel (seeded demand-signal subjects are keyed with the auth secret).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
PAYMENT_WEBHOOK_SECRET=

# Password for the seeded demo accounts (attendees and organisers). Minimum 12 characters.
SEED_DEMO_PASSWORD=
