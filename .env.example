# Copy to .env.local for local development. Never commit real values.

# local | test | preview | production — governs safety guards (seeding, migrations).
APP_ENV=local
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (pnpm db:up). Neon pooled URL in deployed environments.
DATABASE_URL=postgres://gothere:gothere_local@127.0.0.1:54329/gothere
DATABASE_POOL_MAX=5
# Integration tests run against this database and reset it between runs. Must be local and end in _test.
TEST_DATABASE_URL=postgres://gothere:gothere_local@127.0.0.1:54329/gothere_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Demo accounts created by pnpm db:seed (local/test/preview only). Minimum 12 characters.
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- Introduced in later milestones (not read yet) ---
# M3  ANTHROPIC_API_KEY=            server-only; never exposed to the browser
# M3  AI_MODEL_FAST=                e.g. a Claude Haiku model id available to the account
# M3  AI_MONTHLY_BUDGET_MINOR=      hard cap for runtime AI spend, EUR cents
# M1  OPERATIONS_SECRET=            protects manual job execution and Vercel Cron endpoints
# M4  SENTRY_DSN=
