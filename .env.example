# Copy to .env.local for local development. Never commit real values.

# local | test | preview | production — governs safety guards (seeding, migrations).
APP_ENV=local
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (pnpm db:up). Neon pooled URL in deployed environments.
DATABASE_URL=postgres://gothere:gothere_local@127.0.0.1:54329/gothere
DATABASE_POOL_MAX=5
# Integration tests run against this database and reset it between runs. Must be local and end in _test.
TEST_DATABASE_URL=postgres://gothere:gothere_local@127.0.0.1:54329/gothere_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Job runner bearer secret (also used by Vercel Cron as CRON_SECRET). Generate like BETTER_AUTH_SECRET.
CRON_SECRET=
# HMAC key for payment simulator notifications. Generate like BETTER_AUTH_SECRET.
PAYMENT_WEBHOOK_SECRET=
# enabled | disabled. Non-default simulator scenarios (decline, delay, duplicate, timeout...). Defaults: enabled for local/test, disabled elsewhere.
PAYMENT_SIMULATOR_SCENARIOS=

# Demo accounts created by pnpm db:seed (local/test/preview only). Minimum 12 characters.
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- Pre-release access gate. Off locally when empty. On Vercel (APP_ENV=preview/production) the site is CLOSED
# until a password (>= 12 chars) is set, except /privacy and machine endpoints. SITE_ACCESS=open removes the gate.
SITE_ACCESS_PASSWORD=
SITE_ACCESS=

# --- Runtime AI (optional). AI is OFF unless key, model and budget are all set; every feature then falls back. ---
# Server-only; never exposed to the browser.
ANTHROPIC_API_KEY=
# A fast, low-cost model available to the account, e.g. claude-haiku-5-5. Opus ids are rejected.
AI_MODEL_FAST=
# Hard monthly cap for runtime AI spend, in US cents (500 = $5). 0 or empty disables AI calls.
AI_MONTHLY_BUDGET_MINOR=
# Only for models without a built-in price: micro-USD per million tokens (e.g. 100000 = $0.10/MTok).
AI_INPUT_MICRO_USD_PER_MTOK=
AI_OUTPUT_MICRO_USD_PER_MTOK=
# Per-call timeout in ms (default 12000).
AI_TIMEOUT_MS=

# --- Introduced in later milestones (not read yet) ---
# M4  SENTRY_DSN=
